{
  "spec": "mainnet-tool/1",
  "project": {
    "name": "my-elysium-app",
    "chain": "elysium",
    "network": "mainnet",
    "desc": "onchain game assets",
    "root": "my-elysium-app"
  },
  "build": { "chain": "elysium", "target": "my-elysium-app" },
  "dimensions": [
    {
      "id": "mainnet-onchain",
      "checks": [
        { "id": "onchain/gas-price", "type": "rpc", "url": "https://rpc.elysiumchain.tech",
          "method": "eth_gasPrice", "params": [] }
      ]
    },
    {
      "id": "fitur-berfungsi",
      "checks": [
        { "id": "fitur/chainid-guard", "type": "grep", "pattern": "WRONG NETWORK|EXPECTED_CHAIN_ID", "path": "scripts/deploy.ts", "min_count": 2 },
        { "id": "fitur/contract", "type": "files", "patterns": ["contracts/*.sol"], "expect": "any_exist" }
      ]
    }
  ]
}
