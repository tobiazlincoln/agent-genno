{
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "\"$DEVIN_PROJECT_DIR/GLMAGENT DATA/scripts/session-start.sh\"" }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        { "type": "command", "command": "\"$DEVIN_PROJECT_DIR/GLMAGENT DATA/scripts/session-end.sh\"" }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        { "type": "command", "command": "\"$DEVIN_PROJECT_DIR/GLMAGENT DATA/scripts/check-command.sh\"", "timeout": 10 }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(edit|write|apply_patch|notebook_edit)$",
      "hooks": [
        { "type": "command", "command": "\"$DEVIN_PROJECT_DIR/GLMAGENT DATA/scripts/post-edit.sh\"", "timeout": 10 }
      ]
    },
    {
      "matcher": "^exec$",
      "hooks": [
        { "type": "command", "command": "\"$DEVIN_PROJECT_DIR/GLMAGENT DATA/scripts/post-exec.sh\"", "timeout": 10 }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "\"$DEVIN_PROJECT_DIR/GLMAGENT DATA/scripts/stop-verify.sh\"", "timeout": 60 }
      ]
    }
  ]
}
